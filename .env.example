# Neon Postgres connection string (from the Neon dashboard → Connection Details)
# Example: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Anthropic API key (from https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# --- Renewals live source (Google Sheets) ---
# The spreadsheet ID that backs the Renewals tab on /sources.
# It's the long token in the sheet URL: /spreadsheets/d/<THIS_PART>/edit
RENEWALS_SHEET_ID=1lGaWwfYfjemZo6idsY9_qKEIY-EivTWRmNkNRDAlCUc

# Auth uses a Google service account (read-only). Provide credentials via EITHER:
#
#  (A) a downloaded key file — simplest locally. Save the JSON Google gives you
#      as google-service-account.json in the project root (it's git-ignored).
#      Change this only if you put it elsewhere / rename it:
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=google-service-account.json
#
#  (B) the whole JSON pasted on one line — simplest on Vercel. If set, this
#      takes precedence over the key file above:
# GOOGLE_SERVICE_ACCOUNT_JSON=
